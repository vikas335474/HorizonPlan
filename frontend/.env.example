# Copy this file to .env (git-ignored) and fill in a real value.
# Never commit .env.

# Google Sign-In (Login.jsx) — the same OAuth 2.0 Client ID configured as
# GOOGLE_CLIENT_ID in api/db_config.php. Public by design (Google's Identity
# Services JS reads it client-side; ships inside the built bundle), but kept
# out of git anyway since it's per-deployment (a different Client ID for
# local dev vs. the production domain — Google OAuth clients are registered
# against specific authorized JavaScript origins).
VITE_GOOGLE_CLIENT_ID=
